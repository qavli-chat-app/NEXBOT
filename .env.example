# Required: use a long private random value; never publish it
PANEL_KEY=replace-with-a-long-random-secret
# Optional: your WhatsApp number digits only, e.g. countrycode+number
BOT_OWNER=
COMMAND_PREFIX=!
# Persistent volume path on Railway
DATA_DIR=/data
PORT=3000
LOG_LEVEL=info
# Optional AI provider (may have usage limits or charges)
OPENROUTER_API_KEY=
AI_MODEL=openrouter/auto
# Optional workflow webhooks: comma-separated HTTPS hostnames you explicitly trust
WORKFLOW_WEBHOOK_ALLOWLIST=
